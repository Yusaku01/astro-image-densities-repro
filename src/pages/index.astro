---
import { Image } from 'astro:assets';
import fixture from '../assets/fixture.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Astro 7.4.2 image density reproduction</title>
  </head>
  <body>
    <main>
      <h1>Astro 7.4.2 image density reproduction</h1>

      <p>
        <code>{'densities={[1, "1x", 2]}'}</code>
      </p>
      <p>
        Expected srcset descriptors: <code>1x, 2x</code>.
      </p>

      <Image
        id="subject"
        src={fixture}
        width={400}
        height={280}
        densities={[1, '1x', 2]}
        format="webp"
        loading="eager"
        alt="Generated gradient and checkerboard fixture"
      />

      <h2>Actual srcset from the image</h2>
      <pre id="actual-srcset"></pre>
    </main>
  </body>
</html>

<script>
  const image = document.getElementById('subject');
  const output = document.getElementById('actual-srcset');
  if (image instanceof HTMLImageElement && output) {
    output.textContent = image.srcset.split(', ').join(',\n');
  }
</script>

<style>
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
